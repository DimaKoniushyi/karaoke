diff --git a/audio/simpleaudiosample/Source/Utilities/advoicebridge.cpp b/audio/simpleaudiosample/Source/Utilities/advoicebridge.cpp
new file mode 100644
index 0000000..854f6b4
--- /dev/null
+++ b/audio/simpleaudiosample/Source/Utilities/advoicebridge.cpp
@@ -0,0 +1,69 @@
+#include "advoicebridge.h"
+
+namespace {
+constexpr ULONG Capacity = 48000 * 2 * sizeof(INT16) / 10;
+UCHAR g_data[Capacity]{};
+ULONG g_read = 0;
+ULONG g_write = 0;
+ULONG g_size = 0;
+KSPIN_LOCK g_lock{};
+
+struct Guard {
+    KIRQL oldIrql{};
+    bool atDpc = KeGetCurrentIrql() >= DISPATCH_LEVEL;
+    Guard() {
+        if (atDpc) KeAcquireSpinLockAtDpcLevel(&g_lock);
+        else KeAcquireSpinLock(&g_lock, &oldIrql);
+    }
+    ~Guard() {
+        if (atDpc) KeReleaseSpinLockFromDpcLevel(&g_lock);
+        else KeReleaseSpinLock(&g_lock, oldIrql);
+    }
+};
+}
+
+void AdVoiceBridgeInitialize() {
+    KeInitializeSpinLock(&g_lock);
+    g_read = g_write = g_size = 0;
+}
+
+void AdVoiceBridgeWrite(_In_reads_bytes_(byteCount) const UCHAR* source, _In_ ULONG byteCount) {
+    Guard guard;
+    if (byteCount >= Capacity) {
+        source += byteCount - Capacity;
+        byteCount = Capacity;
+        g_read = g_write = g_size = 0;
+    }
+    while (byteCount) {
+        const ULONG chunk = min(byteCount, Capacity - g_write);
+        RtlCopyMemory(g_data + g_write, source, chunk);
+        g_write = (g_write + chunk) % Capacity;
+        source += chunk;
+        byteCount -= chunk;
+        const ULONG free = Capacity - g_size;
+        if (chunk > free) g_read = (g_read + chunk - free) % Capacity;
+        g_size = min(Capacity, g_size + chunk);
+    }
+}
+
+ULONG AdVoiceBridgeRead(_Out_writes_bytes_(byteCount) UCHAR* target, _In_ ULONG byteCount) {
+    Guard guard;
+    const ULONG requested = byteCount;
+    ULONG available = min(byteCount, g_size);
+    const ULONG copied = available;
+    while (available) {
+        const ULONG chunk = min(available, Capacity - g_read);
+        RtlCopyMemory(target, g_data + g_read, chunk);
+        g_read = (g_read + chunk) % Capacity;
+        target += chunk;
+        available -= chunk;
+        g_size -= chunk;
+    }
+    RtlZeroMemory(target, requested - copied);
+    return copied;
+}
+
+void AdVoiceBridgeReset() {
+    Guard guard;
+    g_read = g_write = g_size = 0;
+}
